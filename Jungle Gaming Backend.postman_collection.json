        {
          "name": "Teste de concorrencia",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\nconst url = 'http://localhost:3000/api/v1/wagering/transactions';\r\nconst walletId = 'wallet-id';\r\n\r\nfunction sendBet(item) {\r\n  return new Promise((resolve) => {\r\n    pm.sendRequest({\r\n      url,\r\n      method: 'POST',\r\n      header: {\r\n        'Content-Type': 'application/json',\r\n        'Idempotency-Key': item.key\r\n      },\r\n      body: {\r\n        mode: 'raw',\r\n        raw: JSON.stringify({\r\n          providerId: 'provider-test',\r\n          playerId: 'intrepidPirate',\r\n          walletId,\r\n          externalTransactionId: item.externalTransactionId,\r\n          type: 'BET',\r\n          amount: '70.00',\r\n          currency: 'BRL'\r\n        })\r\n      }\r\n    }, (error, response) => {\r\n      if (error) {\r\n        resolve({\r\n          request: item.externalTransactionId,\r\n          error: error.message\r\n        });\r\n        return;\r\n      }\r\n\r\n      let body;\r\n      try {\r\n        body = response.json();\r\n      } catch {\r\n        body = response.text();\r\n      }\r\n\r\n      resolve({\r\n        request: item.externalTransactionId,\r\n        httpStatus: response.code,\r\n        body\r\n      });\r\n    });\r\n  });\r\n}\r\n\r\nconst requests = [\r\n  {\r\n    key: 'bet-concurrent-key-A',\r\n    externalTransactionId: 'bet-concurrent-A'\r\n  },\r\n  {\r\n    key: 'bet-concurrent-key-B',\r\n    externalTransactionId: 'bet-concurrent-B'\r\n  }\r\n];\r\n\r\nconst results = await Promise.all(requests.map(sendBet));\r\n\r\nconsole.log('Resultados do teste paralelo:', results);\r\npm.environment.set('concurrencyResults', JSON.stringify(results));\r\n"
                ]
              }
            }
          ],
